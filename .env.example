# Copy to .env for a real CHPP deployment — the app auto-loads it on startup
# (real environment variables take precedence over this file).
# With CHPP_MOCK=1 (the default) the app runs entirely on local fixtures and
# never contacts hattrick.org — safe to run before CHPP approval.

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./scoutbridge.db
BASE_URL=http://localhost:8000

# Only after Hattrick has approved the CHPP application:
CHPP_MOCK=1
CHPP_CONSUMER_KEY=
CHPP_CONSUMER_SECRET=
